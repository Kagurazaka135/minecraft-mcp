{
  "name": "minecraft-mcp",
  "version": "1.0.0",
  "description": "MCP server that allows AI agents to play Minecraft using Mineflayer",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "minecraft-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "minecraft",
    "ai",
    "bot",
    "mineflayer",
    "model-context-protocol"
  ],
  "author": "Harjot Singh Rana",
  "homepage": "https://harjotrana.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/harjjotsinghh/minecraft-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/harjjotsinghh/minecraft-mcp/issues"
  },
  "license": "MIT",
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "minecraft-data": "^3.102.3",
    "mineflayer": "^4.33.0",
    "mineflayer-auto-eat": "^5.0.3",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-pvp": "^1.3.2",
    "vec3": "^0.1.10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
